# Copy to .env.production and edit. docker-compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Postgres (somente rede interna do compose — sem porta no host)
POSTGRES_USER=eagle
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=eagle

# Backend
BETTER_AUTH_SECRET=change-me-very-long-random-secret-32+chars
# Domínio público da API (subdomínio dedicado)
BETTER_AUTH_URL=https://api.eagleacademia.com.br
# Origem permitida pelo CORS (domínio do front)
CORS_ORIGIN=https://eagleacademia.com.br

# Set to "true" on first boot to seed admin@admin.com / admin@123, then set to false.
SEED_ON_START=true

# Frontend build args — front e back em domínios separados, precisam ser URLs absolutas.
VITE_API_URL=https://api.eagleacademia.com.br/trpc
VITE_BACKEND_URL=https://api.eagleacademia.com.br

# E-mail transacional (Resend) — FALLBACK.
# O caminho normal é cadastrar em Admin > E-mail (fica no banco). Estas variáveis
# só valem enquanto nada foi salvo no painel; o painel tem prioridade.
# Sem nenhum dos dois os formulários seguem gravando o lead, só não sai e-mail.
RESEND_API_KEY=""
EMAIL_FROM="Eagle Center Fitness <contato@grupogoldeagle.com.br>"
EMAIL_TEAM="contato@grupogoldeagle.com.br"
SITE_URL="https://eagleacademia.com.br"

# Armazenamento de mídia — FALLBACK.
# O caminho normal é configurar em Admin > Armazenamento (fica no banco).
# Sem nada configurado, os uploads ficam no disco da API e são servidos em /uploads.
S3_ENDPOINT=""
S3_REGION="nyc3"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FOLDER=""
S3_FORCE_PATH_STYLE="false"
